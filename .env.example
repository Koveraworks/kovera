# Supabase Configuration
# Obtain these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional base path for deployment (default is /)
# For GitHub Pages subpath deployment (e.g. username.github.io/kovera/), set to /kovera/
# For Cloudflare Pages or custom domains, leave empty or set to /
VITE_BASE_PATH=/
